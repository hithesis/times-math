\msg_new:nnn { times-math } { skip-text-layer }
  {
    Text~font~'#1'~not~found.\iow_newline:
    The~text-font~layer~will~be~skipped;~only~math~fonts~will~be~used.
  }

\bool_new:N \l__mt_text_layer_bool
\bool_set_true:N \l__mt_text_layer_bool
\str_if_eq:VnT \l__mt_text_font_tl { none }
  { \bool_set_false:N \l__mt_text_layer_bool }
\bool_if:NT \l__mt_text_layer_bool
  {
    \exp_args:NV \IfFontExistsTF \l__mt_text_font_tl
      { }
      {
        \msg_warning:nnx { times-math } { skip-text-layer } { \l__mt_text_font_tl }
        \bool_set_false:N \l__mt_text_layer_bool
      }
  }

% Later font assignments override earlier ranges.
\exp_args:NV \setmathfont \l__mt_math_font_tl
\tl_use:N \c__mt_data_common_tl
\tl_use:N \c__mt_data_integrals_tl
\bool_if:NT \l__mt_text_layer_bool
  {
    \str_case:Vn \l__mt_text_font_tl
      {
        { Times~New~Roman }
          {
            \tl_use:N \c__mt_data_tnr_tl
            \tl_use:N \c__mt_data_tnr_italic_tl
          }
        { TeX~Gyre~Termes }
          {
            \tl_use:N \c__mt_data_tgt_tl
            \tl_use:N \c__mt_data_tgt_italic_tl
          }
      }
  }

\cs_new_protected:Npn \__mt_alias:NN #1#2
  { \cs_if_exist:NF #1 { \cs_new_eq:NN #1 #2 } }

\__mt_alias:NN \bm \symbf

\cs_if_exist:NF \mathbbm { \cs_new_protected:Npn \mathbbm #1 { \symbb {#1} } }

\__mt_alias:NN \Bbb \mathbb

% Replace kernel placeholders as well as undefined commands.
\cs_new_protected:Npn \__mt_symbol:nn #1#2
  { \cs_new_protected:Npn #1 { \tex_char:D #2 } }
\cs_new_protected:Npn \__mt_symbol_force:nn #1#2
  { \cs_set_protected:Npn #1 { \tex_char:D #2 } }
\__mt_symbol_force:nn \Box { "25A1 }
\__mt_symbol_force:nn \Diamond { "25C7 }
\__mt_symbol_force:nn \lhd { "22B2 }
\__mt_symbol_force:nn \rhd { "22B3 }
\__mt_symbol_force:nn \unlhd { "22B4 }
\__mt_symbol_force:nn \unrhd { "22B5 }
\__mt_symbol_force:nn \leadsto { "21DD }
\__mt_symbol_force:nn \yen { "00A5 }
\cs_if_exist:NF \square { \__mt_symbol:nn \square { "25A1 } }
\cs_if_exist:NF \lozenge { \__mt_symbol:nn \lozenge { "25CA } }
\cs_if_exist:NF \blacksquare { \__mt_symbol:nn \blacksquare { "25A0 } }
\cs_if_exist:NF \blacklozenge { \__mt_symbol:nn \blacklozenge { "29EB } }
\cs_if_exist:NF \doteqdot { \__mt_symbol:nn \doteqdot { "2251 } }
\cs_if_exist:NF \doublecap { \__mt_symbol:nn \doublecap { "22D2 } }
\cs_if_exist:NF \doublecup { \__mt_symbol:nn \doublecup { "22D3 } }
\cs_if_exist:NF \thicksim { \__mt_symbol:nn \thicksim { "223C } }
\cs_if_exist:NF \thickapprox { \__mt_symbol:nn \thickapprox { "2248 } }
\cs_if_exist:NF \centerdot { \__mt_symbol:nn \centerdot { "00B7 } }

\cs_set_eq:NN \mathrm \symup
\cs_set_eq:NN \mathbf \symbfup
\cs_set_eq:NN \mathit \symit
\cs_set_eq:NN \mathsf \symsfup
\cs_set_eq:NN \mathtt \symtt
\cs_set_eq:NN \boldsymbol \symbf

\msg_new:nnn { times-math } { incompatible-package }
  {
    Package~'#1'~may~conflict~with~times-math.\iow_newline:
    Remove~it~from~the~preamble.~Common~legacy~commands~are~already~provided;
    ~see~the~times-math~manual~for~details.
  }
\AtBeginDocument
  {
    \clist_map_inline:nn
      { amssymb , bm , mathrsfs , latexsym , amsfonts , eucal }
      {
        \@ifpackageloaded {#1}
          { \msg_warning:nnx { times-math } { incompatible-package } {#1} }
          { }
      }
  }

