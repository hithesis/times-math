% Extract times-math.sty with times-math.ins.
% The manuals share times-math.ltx; see times-math.tex and times-math-cn.tex.
% The glyph reference is in times-math-glyphs.tex.
% Range data are generated by dev/gen-ranges.lua; do not edit them by hand.
%
%    \begin{macrocode}
%<*package>
\NeedsTeXFormat{LaTeX2e}
\ProvidesExplPackage{times-math}{2026-10-17}{0.1a}
  {Times New Roman glyphs for Unicode mathematics}

% Process options before loading unicode-math.
\RequirePackage { l3keys2e }

\tl_new:N \l__mt_text_font_tl
\tl_new:N \l__mt_math_font_tl
\tl_new:N \l__mt_math_style_tl
\tl_new:N \l__mt_bold_style_tl
\str_new:N \l__mt_text_font_key_str

\msg_new:nnn { times-math } { unknown-text-font }
  {
    Unknown~text-font~value~'#1'.
    ~Use~Times~New~Roman,~TeX~Gyre~Termes~or~none.
  }
\cs_new_protected:Npn \__mt_normalize_text_font:
  {
    \str_set:Ne \l__mt_text_font_key_str { \l__mt_text_font_tl }
    \str_set:Ne \l__mt_text_font_key_str
      { \str_lowercase:f { \l__mt_text_font_key_str } }
    \str_remove_all:Nn \l__mt_text_font_key_str { ~ }
    \str_case:VnF \l__mt_text_font_key_str
      {
        { timesnewroman } { \tl_set:Nn \l__mt_text_font_tl { Times~New~Roman } }
        { texgyretermes } { \tl_set:Nn \l__mt_text_font_tl { TeX~Gyre~Termes } }
        { none } { \tl_set:Nn \l__mt_text_font_tl { none } }
      }
      {
        \msg_fatal:nnx { times-math } { unknown-text-font }
          { \tl_to_str:V \l__mt_text_font_tl }
      }
  }

\keys_define:nn { times-math }
  {
    text-font .tl_set:N = \l__mt_text_font_tl ,
    text-font .initial:n = Times~New~Roman ,
    text-font .value_required:n = true ,
    math-font .tl_set:N = \l__mt_math_font_tl ,
    math-font .initial:n = XITS~Math ,
    math-style .tl_set:N = \l__mt_math_style_tl ,
    bold-style .tl_set:N = \l__mt_bold_style_tl ,
  }
\ProcessKeysOptions { times-math }
\__mt_normalize_text_font:

\tl_if_empty:NF \l__mt_math_style_tl
  { \exp_args:Nx \PassOptionsToPackage { math-style = \l__mt_math_style_tl } { unicode-math } }
\tl_if_empty:NF \l__mt_bold_style_tl
  { \exp_args:Nx \PassOptionsToPackage { bold-style = \l__mt_bold_style_tl } { unicode-math } }
\RequirePackage { amsmath }
\RequirePackage { unicode-math }

